# =========================
# Dependencies
# =========================
node_modules/
**/node_modules/

# =========================
# Environment / Secrets
# =========================
**/.env
**/.env.*

# Allow committing example templates (no secrets)
!.env.example
!.env.template
!.env.sample

# =========================
# Builds / Bundlers
# =========================
dist/
build/
**/dist/
**/build/
.vite/
**/.vite/
.next/
out/

# =========================
# Logs
# =========================
logs/
**/logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
lerna-debug.log*

# =========================
# Test / Coverage
# =========================
coverage/
**/coverage/
.nyc_output/
*.lcov
playwright-report/
test-results/

# =========================
# Playwright persistent profiles / caches / auth
# =========================
vet-api/playwright-registry-worker/
vet-api/playwright-profile/
**/playwright-profile/
vet-api/playwright-auth-state.json
**/playwright-auth-state.json
**/.cache/
tmp/
temp/

# =========================
# Editor / IDE
# =========================
.vscode/
.idea/
*.swp

# =========================
# OS
# =========================
.DS_Store
Thumbs.db

# =========================
# Certificates / Keys (avoid accidental commits)
# =========================
*.pem
*.key
*.crt

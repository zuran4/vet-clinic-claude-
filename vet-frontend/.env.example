# =========================
# Frontend runtime config (Vite)
# =========================

# API base URL (backend)
VITE_API_BASE_URL=http://localhost:5000

# Optional: Registry worker base URL (if frontend calls it directly)
# If your frontend always talks to backend only, leave empty.
VITE_REGISTRY_WORKER_URL=

# Build info (optional)
VITE_APP_ENV=development

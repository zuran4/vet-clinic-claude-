# Server
NODE_ENV=development
PORT=5000
LOG_LEVEL=info

# Database
MONGO_URI=

# Auth / security
JWT_SECRET=
JWT_EXPIRES_IN=7d
INTERNAL_API_KEY=
ENCRYPTION_KEY=

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173

# Δημόσια διεύθυνση αυτού του backend — για absolute URLs σε εικόνες μέσα σε emails
PUBLIC_BASE_URL=

# SMTP — χρησιμοποιείται ΜΟΝΟ από το monitor.mjs (health-check alerts στον developer).
# Τα emails ειδοποιήσεων της κλινικής (ραντεβού, εμβόλια, γενέθλια, welcome) ΔΕΝ διαβάζουν
# από εδώ — ρυθμίζονται από το UI (Ρυθμίσεις → Email) και αποθηκεύονται στη βάση.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Twilio — χρησιμοποιείται ΜΟΝΟ από το smsWorker.js (ειδοποίηση λήξης προϊόντων προς
# τον admin, μέσω Redis queue — βλ. ADMIN_PHONE παρακάτω). Τα SMS ειδοποιήσεων προς
# πελάτες (ραντεβού, εμβόλια, γενέθλια, αγορές, welcome) ΔΕΝ διαβάζουν από εδώ —
# ρυθμίζονται από το UI (Ρυθμίσεις → SMS) και αποθηκεύονται στη βάση.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
ADMIN_PHONE=

# Registry worker (pet.gov.gr)
REGISTRY_WORKER_URL=http://localhost:5051
REGISTRY_WORKER_HEADLESS=true
PET_BOOKLET_BASE_URL=https://pet.gov.gr/emzs-backoffice/
PET_USERNAME=
PET_PASSWORD=
REGISTRY_WORKER_SESSION_TIMEOUT_MS=
REGISTRY_WORKER_LOOKUP_TIMEOUT_MS=

# Monitoring
SENTRY_DSN=
SYNTHETIC_USER_PIN=

# MASTER ADMIN APP (control-plane) event reporting — κενό = απενεργοποιημένο
CONTROL_PLANE_API_URL=
CONTROL_PLANE_EVENTS_KEY=

# AI (auto-changelog κ.λπ.)
ANTHROPIC_API_KEY=

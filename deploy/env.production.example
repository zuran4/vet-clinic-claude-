# =============================================================================
# .env.production.example
# Αντέγραψε αυτό το αρχείο ως:  /opt/vetty/vet-api/.env
# και συμπλήρωσε τις τιμές.
# ΠΟΤΕ μην το κάνεις commit με πραγματικά credentials.
# =============================================================================

NODE_ENV=production
PORT=5000

# ── MongoDB Atlas ─────────────────────────────────────────────────────────────
# Η σύνδεση πηγαίνει στο vetAdmin DB (ο tenantConnectionManager
# δημιουργεί αυτόματα ξεχωριστές συνδέσεις ανά κλινική)
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/vetAdmin?retryWrites=true&w=majority

# ── JWT ───────────────────────────────────────────────────────────────────────
# Δημιούργησε με: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=ΒΑΛΕ_ΕΔΩ_ΤΥΧΑΙΟ_STRING_64_ΧΑΡΑΚΤΗΡΕΣ
JWT_EXPIRES_IN=15m

# ── Encryption ────────────────────────────────────────────────────────────────
# Χρησιμοποιείται για κρυπτογράφηση ευαίσθητων δεδομένων
# Δημιούργησε με: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=ΒΑΛΕ_ΕΔΩ_ΤΥΧΑΙΟ_STRING_32_ΧΑΡΑΚΤΗΡΕΣ

# ── CORS ──────────────────────────────────────────────────────────────────────
# Ποιά domains επιτρέπονται να καλούν το API
CORS_ORIGINS=https://app.vetty.gr,https://www.vetty.gr

# ── Redis (προαιρετικό — για BullMQ queues) ───────────────────────────────────
# Αν δεν έχεις Redis, άφησε κενό
REDIS_URL=

# ── SMTP (για αποστολή email) ─────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# ── Twilio (για SMS — προαιρετικό) ───────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_FROM=

# ── Registry Worker (pet.gov.gr — προαιρετικό) ───────────────────────────────
REGISTRY_WORKER_URL=http://localhost:5051
REGISTRY_WORKER_HEADLESS=true
PET_BOOKLET_BASE_URL=https://pet.gov.gr/emzs-backoffice/
PET_USERNAME=
PET_PASSWORD=

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info
